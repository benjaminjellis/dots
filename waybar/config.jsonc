{
  // "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 32, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 0, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": [
    "custom/apple",
    "custom/menu-file",
    "custom/menu-edit",
    "custom/menu-view",
    "custom/menu-label",
    "custom/menu-special",
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "clock"
  ],
  "idle_inhibitor": {
    "format": "{icon} ",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "timeout": 90
  },
  "custom/apple": {
    "format": "",
    "tooltip": false,
    "on-click": "onagre"
  },
  "custom/menu-file": {
    "format": "File",
    "tooltip": false,
    "on-click": "onagre"
  },
  "custom/menu-edit": {
    "format": "Edit",
    "tooltip": false
  },
  "custom/menu-view": {
    "format": "View",
    "tooltip": false
  },
  "custom/menu-label": {
    "format": "Label",
    "tooltip": false
  },
  "custom/menu-special": {
    "format": "Special",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{icon}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "󰈹",
      "5": "󱎏",
      "7": "󰒱",
      "urgent": "!"
    },
    "persistent-workspaces": {
      "*": 5
    }
  },
  "tray": {
    // "icon-size": INT
    "spacing": 4
  },
  "network": {
    "format-wifi": ", ({signalStrength}%)",
    "format-ethernet": " {ifname}",
    "tooltip-format": " {ifname} via {gwaddr}",
    "format-linked": ", ({signalStrength}%)",
    "format-disconnected": "Disconnected ⚠ {ifname}",
    "format-alt": " {ifname}: {ipaddr}/{cidr}"
  },
  "clock": {
    "interval": 60,
    "format": "{:%a %b %d  %I:%M %p}"
  },
  "cpu": {
    "format": "{usage}%   ",
    "tooltip": false
  },
  "battery": {
    "interval": 60,
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "{icon}  Full",
    "format-alt": "{icon}  {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-time": "{H}h {M}min",
    "tooltip": true
  }
  // "pulseaudio": {
  //   "format": "{icon}",
  //   "format-muted": "󰝟",
  //   "format-icons": {
  //     "default": [
  //       "",
  //       "",
  //       "󰕾"
  //     ]
  //   },
  //   "on-click": "pavucontrol &",
  //   "on-click-right": "pamixer -t",
  //   "scroll-step": 5,
  //   "on-scroll-up": "~/.config/waybar/scripts/volume.sh --inc",
  //   "on-scroll-down": "~/.config/waybar/scripts/volume.sh --dec"
  // }
  // "wireplumber": {
  //   "format": "{volume}%   ",
  //   "format-muted": "",
  //   "on-click": "qpwgraph",
  //   "format-icons": [
  //     "󰕿",
  //     "󰖀",
  //     "󰕾"
  //   ]
  // },
}
